{
  "name": "nvim.setup",
  "version": "1.0.0",
  "private": true,
  "description": "Portable Neovim setup",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "changelog": "node scripts/changelog.mjs",
    "dev": "nx run web:dev",
    "build": "nx run web:build",
    "test": "nx run-many -t test",
    "test:setup": "nx run setup:test",
    "test:workspace": "node --test scripts/tests/workspace.test.mjs && bash scripts/tests/bootstrap.test.sh && bash scripts/tests/scan.test.sh",
    "scan": "bash scripts/scan.sh",
    "scan:sast": "bash scripts/scan.sh sast",
    "scan:audit": "bash scripts/scan.sh audit",
    "test:web:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@commitlint/parse": "^21.2.3",
    "@playwright/test": "1.58.2",
    "husky": "^9.1.7",
    "nx": "22.7.12",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "brace-expansion@>=4": "5.0.12",
      "follow-redirects": "^1.16.1",
      "postcss-selector-parser": "^6.1.5",
      "rollup": "4.65.0",
      "smol-toml": "^1.7.1",
      "tinypool": "^2.1.2"
    }
  }
}
