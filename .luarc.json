{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "?.lua",
      "?/init.lua",
      "nvim/lua/?.lua",
      "nvim/lua/?/init.lua",
      "nvim/?.lua"
    ]
  },
  "workspace": {
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": ["vim"]
  }
}
